set(
    SYMFORCE_GENERATED_DIR
    "${CMAKE_CURRENT_SOURCE_DIR}/generated"
)

set(
    SYMFORCE_EDGE_RESIDUAL_HEADER
    "${SYMFORCE_GENERATED_DIR}/edge_residual.h"
)

set(
    SYMFORCE_EDGE_JACOBIAN_HEADER
    "${SYMFORCE_GENERATED_DIR}/edge_jacobian.h"
)


if(
    EXISTS "${SYMFORCE_EDGE_RESIDUAL_HEADER}"
    AND
    EXISTS "${SYMFORCE_EDGE_JACOBIAN_HEADER}"
)

    # Add generated-kernel wrappers and graph/solver code to the existing library.
    target_sources(
        cora_symforce
        PRIVATE
            src/symforce_pgo_cost.cpp
            src/graph_linearization.cpp
            src/gauss_newton.cpp
            src/symmetric_solver.cpp
    )

    target_include_directories(
        cora_symforce
        PRIVATE
            "${SYMFORCE_GENERATED_DIR}"
    )


    # Low-level generated residual/Jacobian equivalence test.
    add_executable(
        test_symforce_edge_equivalence
        tests/test_symforce_edge_equivalence.cpp
    )

    target_include_directories(
        test_symforce_edge_equivalence
        PRIVATE
            "${SYMFORCE_GENERATED_DIR}"
    )

    target_link_libraries(
        test_symforce_edge_equivalence
        PRIVATE
            Eigen3::Eigen
    )


    # Validate the local least-squares linearization generated by SymForce.
    add_executable(
        test_symforce_linearization
        tests/test_symforce_linearization.cpp
    )

    target_include_directories(
        test_symforce_linearization
        PRIVATE
            "${SYMFORCE_GENERATED_DIR}"
    )

    target_link_libraries(
        test_symforce_linearization
        PRIVATE
            Eigen3::Eigen
    )


    # Validate sparse graph assembly and constrained/free Jacobian partitioning.
    add_executable(
        test_graph_linearization
        tests/test_graph_linearization.cpp
    )

    target_link_libraries(
        test_graph_linearization
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # Validate the 2D g2o loader against the same graph pipeline.
    add_executable(
        test_g2o_dataset
        tests/test_g2o_dataset.cpp
    )

    target_link_libraries(
        test_g2o_dataset
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # Full sparse Gauss-Newton baseline on a synthetic graph.
    add_executable(
        test_gauss_newton
        tests/test_gauss_newton.cpp
    )

    target_link_libraries(
        test_gauss_newton
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # Dataset-level benchmark utility.
    add_executable(
        benchmark_g2o
        apps/benchmark_g2o.cpp
    )

    target_link_libraries(
        benchmark_g2o
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # End-to-end dataset optimizer and trajectory exporter.
    add_executable(
        optimize_g2o
        apps/optimize_g2o.cpp
    )

    target_link_libraries(
        optimize_g2o
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # Controlled fixed-linearization comparison between SparseQR and the
    # symmetric normal-equation path.
    add_executable(
        test_symmetric_solver
        tests/test_symmetric_solver.cpp
    )

    target_link_libraries(
        test_symmetric_solver
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # Dataset benchmark for SparseQR versus SimplicialLDLT on the same J.
    add_executable(
        benchmark_linear_solvers
        apps/benchmark_linear_solvers.cpp
    )

    target_link_libraries(
        benchmark_linear_solvers
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    # Graph-level reference-vs-SymForce PGO test.
    add_executable(
        test_symforce_pgo_cost
        tests/test_symforce_pgo_cost.cpp
    )

    target_link_libraries(
        test_symforce_pgo_cost
        PRIVATE
            cora_symforce
            Eigen3::Eigen
    )


    if(BUILD_TESTING)

        add_test(
            NAME symforce_edge_equivalence
            COMMAND test_symforce_edge_equivalence
        )

        add_test(
            NAME symforce_pgo_cost
            COMMAND test_symforce_pgo_cost
        )

        add_test(
            NAME symforce_linearization
            COMMAND test_symforce_linearization
        )

        add_test(
            NAME graph_linearization
            COMMAND test_graph_linearization
        )

        add_test(
            NAME g2o_dataset
            COMMAND test_g2o_dataset
        )

        add_test(
            NAME gauss_newton
            COMMAND test_gauss_newton
        )

        add_test(
            NAME symmetric_solver
            COMMAND test_symmetric_solver
        )

    endif()


else()

    message(
        STATUS
        "SymForce generated headers not found. "
        "Run codegen/python/generate_pgo_residuals.py first."
    )

endif()
